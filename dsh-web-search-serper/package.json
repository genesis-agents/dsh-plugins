{
  "name": "@ai4gensteam/dsh-web-search",
  "version": "0.2.0",
  "description": "Web search for the DeepSeek Harness ctx.web seam, over interchangeable backends: Serper, Tavily, and Brave",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "web-search",
    "serper",
    "tavily",
    "brave-search"
  ],
  "homepage": "https://github.com/genesis-agents/dsh-plugins/tree/main/dsh-web-search-serper#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genesis-agents/dsh-plugins.git",
    "directory": "dsh-web-search-serper"
  },
  "bugs": "https://github.com/genesis-agents/dsh-plugins/issues",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
