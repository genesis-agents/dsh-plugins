{
  "name": "@ai4gensteam/dsh-agents-swarm",
  "version": "0.4.0",
  "description": "A source library for DeepSeek Harness: 72 feeds on an hourly timer, a reader with transcripts and translation, and a publisher that turns what it collects into a podcast, a digest, or a report",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "rss",
    "feed-reader",
    "podcast",
    "text-to-speech",
    "digest"
  ],
  "homepage": "https://github.com/genesis-agents/dsh-plugins/tree/main/dsh-agents-swarm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genesis-agents/dsh-plugins.git",
    "directory": "dsh-agents-swarm"
  },
  "bugs": "https://github.com/genesis-agents/dsh-plugins/issues",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "lib",
    "tests",
    "cordis.patch.yml",
    "pnpm-workspace.yaml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^30.0.1",
    "msedge-tts": "^2.0.7",
    "turndown": "^7.2.4"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  }
}
